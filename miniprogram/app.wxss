page {
  background: #b8cbe1;
  color: #102a4f;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  font-size: 28rpx;
}

button::after { border: 0; }

.card {
  background: rgba(255, 255, 255, .94);
  border: 1rpx solid rgba(255, 255, 255, .82);
  border-radius: 34rpx;
  box-shadow: 0 18rpx 42rpx rgba(21, 51, 91, .13);
}

.muted { color: #72829a; }
.pill {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #dfe9f5;
  color: #0c3d78;
  font-size: 22rpx;
  font-weight: 600;
}
