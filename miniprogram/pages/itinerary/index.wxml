<view class="itinerary-page">
<map wx:if="{{hasTrip && !offline && !readOnly}}" class="itinerary-map"
    latitude="{{latitude}}" longitude="{{longitude}}" scale="13"
    markers="{{markers}}" polyline="{{polyline}}" include-points="{{includePoints}}" bindmarkertap="onMarker"
    bindtap="openAddPlace" bindpoitap="openAddPlace"
    enable-3D="{{false}}" show-location="{{false}}"></map>
<canvas wx:if="{{hasTrip && (offline || readOnly)}}" canvas-id="offlineRouteCanvas" class="offline-canvas"></canvas>
<view wx:if="{{!hasTrip}}" class="empty-map"></view>

  <xj-nav-bar title="{{title}}" subtitle="{{subtitle}}" left-text="我的行程"
    bind:left="onMyTrips" bind:ready="onNavReady"></xj-nav-bar>

  <view wx:if="{{hasTrip}}" class="quality-overlay" style="top:{{navH + 8}}px">
    <xj-quality-badge score="{{score}}" status="{{qualityStatus}}" bind:tap="openInsight"></xj-quality-badge>
  </view>
  <view wx:if="{{hasTrip && alerts.length && alerts[0].type==='risk'}}" class="map-risk-overlay" style="top:{{navH + 52}}px">
    <xj-alert-bar alerts="{{alerts}}" bind:action="onAlertAction"></xj-alert-bar>
  </view>

  <view wx:if="{{loading}}" class="loading-panel" style="top:{{navH + 24}}px">
    <xj-skeleton type="card" rows="{{3}}"></xj-skeleton>
  </view>

  <view wx:if="{{!loading && !hasTrip}}" class="empty-panel" style="padding-top:{{navH}}px">
    <view wx:if="{{offlineNoCache}}" class="offline-empty"><view class="offline-empty__icon">OFF</view><view class="panel-title">网络不可用</view><view class="panel-sub">这台手机上还没有缓存过行程，联网后才能打开</view><xj-button type="primary" bind:tap="retryOnline">重试</xj-button></view>
    <xj-empty-state wx:else prompts="{{emptyPrompts}}" bind:prompt="onEmptyPrompt">
      <xj-button type="primary" block bind:tap="startPlanning">开始规划</xj-button>
    </xj-empty-state>
  </view>

  <xj-bottom-sheet wx:if="{{hasTrip}}" level="{{level}}" top-offset="{{navH}}" scroll-disabled="{{sorting}}"
    header-height="{{offline ? 224 : 208}}" bind:change="onLevel">
    <view slot="header" class="sheet-header">
      <xj-day-tabs days="{{days}}" current="{{currentDay}}" bind:change="onDay"></xj-day-tabs>
      <view class="sheet-header__summary">{{daySummary}}</view>
      <xj-offline-bar wx:if="{{offline || readOnly}}"
        text="{{tripStatus==='traveled' ? '已出行 · 只读' : offline ? '离线 · 显示 ' + cachedAt + ' 的版本' : '云端暂不可用 · 显示本地版本'}}"
        sub="{{tripStatus==='traveled' ? '原行程与对话记录保留不变' : '只读模式，联网后可修改'}}" bind:retry="retryOnline"></xj-offline-bar>
      <view wx:if="{{tripStatus==='traveled'}}" class="copy-trip" bindtap="copyAsNewTrip">复制为新行程</view>
      <xj-alert-bar wx:if="{{tripStatus!=='traveled' && (!alerts.length || alerts[0].type!=='risk')}}" alerts="{{alerts}}" bind:action="onAlertAction"></xj-alert-bar>
    </view>

    <view wx:if="{{conversationOpen}}" class="conversation">
      <view class="panel-title">对话记录</view>
      <view class="panel-sub">{{title}} · 本行程</view>
      <view wx:for="{{messages}}" wx:key="index" class="message {{item.role==='user'?'is-user':'is-agent'}}">
        <text>{{item.content}}</text>
      </view>
      <view wx:if="{{latestDiff.changed_items.length || latestDiff.warnings.length}}" class="diff-panel">
        <view class="changes-title">本次改动</view>
        <view wx:for="{{latestDiff.changed_items}}" wx:key="index" class="diff-row">
          <text class="diff-action">{{item.action==='ADD'?'新增':item.action==='REMOVE'?'移除':'调整'}}</text>
          <text>第{{item.day}}天 · {{item.name}}{{item.before?' · '+item.before:''}}{{item.after?' → '+item.after:''}}</text>
        </view>
        <view wx:for="{{latestDiff.warnings}}" wx:key="index" class="diff-warning">提醒：{{item}}</view>
      </view>
      <view wx:if="{{changes.length}}" class="changes-title">行程改动</view>
      <view wx:for="{{changes}}" wx:key="plan_version" class="change-card">
        <view class="change-card__main">
          <text class="change-card__title">{{item.summary}}</text>
          <text class="change-card__meta">版本 {{item.plan_version}}</text>
        </view>
        <view class="change-card__action" data-index="{{index}}" bindtap="onViewChange">看改动</view>
        <view wx:if="{{item.can_undo && !readOnly}}" class="change-card__action" bindtap="undoLatestChange">撤销</view>
      </view>
    </view>

    <view wx:elif="{{qualityOpen}}" class="quality-panel">
      <view class="quality-panel__score">{{qualityStatus==='unknown'?'—':score}}</view>
      <view class="panel-title">{{qualityStatus==='pass'?'评审已通过':qualityStatus==='unknown'?'评审状态未知':'行程草稿'}}</view>
      <view class="panel-sub">{{qualityStatus==='pass'?'Reviewer 已通过':qualityStatus==='unknown'?'没有可用的评审记录':'草稿 · 仍需优化'}}</view>
      <view wx:if="{{!qualityIssues.length}}" class="quality-panel__empty">暂无待处理问题</view>
      <view wx:for="{{qualityIssues}}" wx:key="index" class="quality-panel__issue">{{index + 1}}. {{item}}</view>
    </view>

    <xj-node-card wx:elif="{{focusItem}}"
      item-id="{{focusItem.item_id}}" index="{{focusItem.index}}" name="{{focusItem.displayName}}"
      time="{{focusItem.time}}" duration="{{focusItem.durationLabel}}" meta="{{focusItem.location}}"
      rating="{{focusItem.rating}}" locked="{{focusItem.user_locked}}" tip="{{focusItem.reason}}"
      expanded="{{level==='full'}}" play-duration="{{focusItem.durationLabel}}" steps="{{focusItem.steps}}"
      bind:expand="onExpandNode" bind:close="onCloseNode" bind:action="onNodeAction">
      <view slot="play" wx:if="{{focusItem.play}}" class="play-extra">
        <view class="play-extra__why"><text>为什么给你排</text>{{focusItem.play.why}}</view>
        <view class="play-extra__cols"><view><text>必看</text>{{focusItem.play.mustSee.join('、')}}</view><view><text>可跳过</text>{{focusItem.play.skippable.join('、')}}</view></view>
        <view class="play-extra__tip">避坑：{{focusItem.play.tips.join('；')}}</view>
        <view class="play-extra__after"><text>出来之后</text>{{focusItem.play.after}}</view>
        <view class="play-extra__source">资料更新于 {{focusItem.play.updatedAt}} · {{focusItem.play.sourceStatus}}</view>
        <view class="play-extra__actions"><view bindtap="expandPlay">展开到行程</view><view wx:if="{{focusItem.play.sources.length}}" data-url="{{focusItem.play.sources[0].url}}" bindtap="copyPlaySource">看原笔记 {{focusItem.play.sources.length}} 篇</view></view>
      </view>
    </xj-node-card>

    <view wx:else class="day-list">
      <view wx:if="{{!readOnly}}" class="sort-hint">长按右侧手柄拖动地点；已锁定节点需先解锁</view>
      <block wx:for="{{dayEntries}}" wx:key="index">
        <view class="timeline-row {{sorting && index===dragIndex?'is-dragging':''}}" data-index="{{index}}" bindlongpress="startReorder" bindtouchmove="moveReorder" bindtouchend="endReorder" bindtouchcancel="endReorder">
          <xj-empty-slot wx:if="{{item.node.pendingMeal}}" time="{{item.node.time}}"
            label="{{item.node.activity==='dinner'?'晚餐 · 待定':'午餐 · 待定'}}"
            action-text="" interactive="{{false}}"></xj-empty-slot>
          <view wx:else class="timeline-card-row"><view class="timeline-card-main"><xj-itinerary-card item-id="{{item.node.item_id}}" time="{{item.node.time}}"
            duration="{{item.node.durationLabel}}" name="{{item.node.displayName}}" meta="{{item.node.meta}}"
            locked="{{item.node.user_locked}}" rating="{{item.node.rating}}"
            conflict="{{item.node.conflictReason}}"
            active="{{focusItem && focusItem.item_id===item.node.item_id}}" bind:tap="onCard"></xj-itinerary-card></view><view wx:if="{{!readOnly && item.node.draggable}}" class="drag-handle">⋮⋮</view></view>
          <xj-transit wx:if="{{item.transit}}" mode="{{item.transit.mode}}"
            text="{{item.transit.text}}" estimated="{{item.transit.estimated}}"></xj-transit>
        </view>
      </block>
    </view>
  </xj-bottom-sheet>

  <view wx:if="{{reorderPreview}}" class="reorder-preview-mask" catchtap="cancelReorderPreview">
    <view class="reorder-preview" catchtap="keepReorderPreview">
      <view class="reorder-preview__title">{{reorderPreview.conflicts.length?'排序后有时间冲突':'确认当天顺序'}}</view>
      <view class="reorder-preview__summary">路线和后续时间已按新顺序预计算；确认后才会写入行程。</view>
      <view wx:for="{{reorderPreview.conflicts}}" wx:key="index" class="reorder-preview__warning">提醒：{{item}}</view>
      <scroll-view scroll-y class="reorder-preview__body">
        <view wx:for="{{reorderPreview.schedule}}" wx:key="index" class="reorder-preview__row">
          <text class="reorder-preview__time">{{item.time}}</text>
          <view class="reorder-preview__place"><text>{{item.name}}</text><text wx:if="{{item.conflict}}" class="reorder-preview__warning">{{item.conflict}}</text></view>
          <text wx:if="{{item.locked}}" class="reorder-preview__locked">已锁定</text>
        </view>
        <view wx:if="{{reorderPreview.routeSummaries.length}}" class="reorder-preview__routes">
          <view class="changes-title">路段预估</view>
          <view wx:for="{{reorderPreview.routeSummaries}}" wx:key="index">{{item.mode}} {{item.minutes}} 分钟 · {{item.status}}</view>
        </view>
      </scroll-view>
      <view class="reorder-preview__actions">
        <view class="reorder-preview__cancel" bindtap="cancelReorderPreview">取消</view>
        <view class="reorder-preview__apply" bindtap="confirmReorderPreview">确认应用</view>
      </view>
    </view>
  </view>

  <view wx:if="{{hasTrip}}" class="chat-wrap">
    <view wx:if="{{readOnly}}" class="readonly-chat" bindtap="openConversation">查看对话记录 · 只读</view>
    <view class="add-place-btn {{readOnly?'is-off':''}}" bindtap="openAddPlace">＋ 加地点</view>
    <xj-chat-bar wx:if="{{!readOnly}}" class="chat-input" disabled="{{readOnly}}" sending="{{sending}}"
      placeholder="{{readOnly?'离线只读，联网后可修改':'告诉行迹：下午想轻松点…'}}"
      bind:focus="onChatFocus" bind:send="onSend"></xj-chat-bar>
  </view>
  <xj-toast id="toast" bind:action="onToastAction"></xj-toast>
</view>
