<view class="page">
  <view class="decor decor-one"></view>
  <view class="decor decor-two"></view>

  <view class="hero">
    <view class="brand-lockup">
      <view class="brand-mark">⌖</view>
      <view>
        <text class="eyebrow">AI TRAVEL COPILOT</text>
        <view class="brand">行迹</view>
      </view>
    </view>
    <button class="reset" bindtap="resetSession"><text class="reset-plus">＋</text> 新规划</button>
  </view>

  <view class="explore-card">
    <view class="explore-copy">
      <text class="explore-kicker">DISCOVER YOUR NEXT STOP</text>
      <text class="explore-title">下一站，去哪里？</text>
      <text class="explore-subtitle">从一句想法，到可执行的每一天</text>
    </view>
    <view class="compass"><text>⌖</text></view>
    <view class="mountains mountain-back"></view>
    <view class="mountains mountain-front"></view>
  </view>

  <view class="status-row">
    <view class="status-chip"><text class="status-dot"></text>{{stageLabel}}</view>
    <text wx:if="{{polling}}" class="working">正在调研 · {{researchItems.length}} 项</text>
    <text wx:else class="status-hint">云端已连接</text>
  </view>

  <view class="tabs card">
    <view class="tab {{activeTab === 'chat' ? 'active' : ''}}" data-tab="chat" bindtap="setTab"><text class="tab-icon">✦</text><text>对话</text></view>
    <view class="tab {{activeTab === 'candidates' ? 'active' : ''}}" data-tab="candidates" bindtap="setTab"><text class="tab-icon">⌕</text><text>发现</text></view>
    <view class="tab {{activeTab === 'plan' ? 'active' : ''}}" data-tab="plan" bindtap="setTab"><text class="tab-icon">▤</text><text>行程</text></view>
  </view>

  <block wx:if="{{activeTab === 'chat'}}">
    <scroll-view class="quick-strip" scroll-x="true" enhanced="true" show-scrollbar="false">
      <view class="quick-list">
        <view wx:for="{{quickPrompts}}" wx:key="title" class="quick-card card" data-prompt="{{item.text}}" bindtap="selectQuickPrompt">
          <view class="quick-icon">{{item.icon}}</view>
          <text class="quick-title">{{item.title}}</text>
          <text class="quick-action">开始规划 →</text>
        </view>
      </view>
    </scroll-view>

    <view wx:if="{{requirement}}" class="requirement card">
      <view class="section-title"><text class="section-icon">⌖</text> 当前旅程</view>
      <view class="requirement-grid">
        <view><text>目的地</text><text class="value">{{requirement.destination || '待确认'}}</text></view>
        <view><text>天数</text><text class="value">{{requirement.duration_days || '—'}} 天</text></view>
        <view><text>人数</text><text class="value">{{requirement.num_travelers || '—'}} 人</text></view>
        <view><text>预算</text><text class="value">{{requirement.budget || '—'}} {{requirement.budget_currency || ''}}</text></view>
      </view>
    </view>

    <view class="conversation-head"><text>与行迹对话</text><text>AI</text></view>
    <scroll-view class="messages card" scroll-y="true" scroll-into-view="{{scrollTo}}">
      <view wx:for="{{messages}}" wx:key="id" id="msg-{{item.id}}" class="message-row {{item.role}}">
        <view class="bubble">{{item.content}}</view>
      </view>
      <view wx:if="{{busy}}" class="message-row assistant"><view class="bubble typing">正在思考…</view></view>
    </scroll-view>

    <view wx:if="{{polling}}" class="research card">
      <view class="section-title">实时调研进度</view>
      <view wx:for="{{researchItems}}" wx:key="key" class="research-line">
        <text>{{item.key}}</text><text class="status {{item.state}}">{{item.state}}</text>
      </view>
    </view>

    <view wx:if="{{error}}" class="error">{{error}}</view>
    <view class="composer card">
      <view class="composer-pin">⌖</view>
      <textarea value="{{input}}" bindinput="onInput" maxlength="1000" auto-height placeholder="告诉我想去哪里、几天和预算…" />
      <button class="send" loading="{{busy}}" disabled="{{busy || !input}}" bindtap="sendMessage">↑</button>
    </view>
  </block>

  <block wx:elif="{{activeTab === 'candidates'}}">
    <view wx:if="{{!candidateGroups.length}}" class="empty card">完成需求确认和调研后，候选体验会出现在这里。</view>
    <view wx:for="{{candidateGroups}}" wx:key="key" class="candidate-group">
      <view class="section-heading"><text>{{item.label}}</text><text class="count">{{item.items.length}} 个</text></view>
      <view wx:for="{{item.items}}" wx:for-item="experience" wx:key="id" class="candidate card">
        <view class="candidate-top"><text class="name">{{experience.name}}</text><text wx:if="{{experience.rating}}">★ {{experience.rating}}</text></view>
        <view class="muted">{{experience.region || experience.location}}</view>
        <view class="description">{{experience.short_description || experience.detailed_description}}</view>
        <view class="meta"><text>{{experience.duration_minutes}} 分钟</text><text>{{experience.cost}} {{experience.currency}}</text></view>
      </view>
    </view>
  </block>

  <block wx:else>
    <view wx:if="{{!itineraryDays.length}}" class="empty card">选择候选并完成规划后，逐日行程会出现在这里。</view>
    <view wx:for="{{itineraryDays}}" wx:key="day_number" class="day card">
      <view class="day-title"><text>第 {{item.day_number}} 天</text><text>{{item.date || ''}}</text></view>
      <view wx:for="{{item.items}}" wx:for-item="activity" wx:key="item_id" class="timeline-item">
        <view class="time">{{activity.time}}</view>
        <view class="timeline-dot"></view>
        <view class="activity">
          <text class="name">{{activity.displayLocation || activity.location || activity.name}}</text>
          <text wx:if="{{activity.activity}}" class="activity-kind">{{activity.activity}}</text>
          <text wx:if="{{activity.transport}}" class="muted">{{activity.transport}}</text>
        </view>
      </view>
    </view>
    <view wx:if="{{warnings.length}}" class="warning card">
      <view class="section-title">出发前提醒</view>
      <view wx:for="{{warnings}}" wx:key="*this">• {{item}}</view>
    </view>
  </block>
</view>
