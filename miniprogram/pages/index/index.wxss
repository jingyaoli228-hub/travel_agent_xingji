.page { position: relative; min-height: 100vh; box-sizing: border-box; padding: 28rpx 28rpx 72rpx; overflow: hidden; }
.decor { position: absolute; z-index: -1; border-radius: 50%; background: rgba(41, 88, 145, .15); }
.decor-one { top: -130rpx; right: -170rpx; width: 420rpx; height: 420rpx; }
.decor-two { top: 610rpx; left: -160rpx; width: 300rpx; height: 300rpx; border: 30rpx solid rgba(255,255,255,.18); background: transparent; }
.hero { display: flex; align-items: center; justify-content: space-between; padding: 10rpx 4rpx 24rpx; }
.brand-lockup { display: flex; align-items: center; gap: 18rpx; }
.brand-mark { display: flex; align-items: center; justify-content: center; width: 72rpx; height: 72rpx; border-radius: 24rpx; background: #0d3e7a; color: #fff; font-size: 40rpx; box-shadow: 0 12rpx 24rpx rgba(10, 49, 96, .23); }
.eyebrow { display: block; color: #486581; font-size: 17rpx; font-weight: 800; letter-spacing: 3rpx; }
.brand { margin-top: 2rpx; color: #102a4f; font-size: 50rpx; font-weight: 900; line-height: 1; letter-spacing: 4rpx; }
.reset { margin: 0; padding: 0 22rpx; height: 66rpx; line-height: 66rpx; border-radius: 999rpx; background: rgba(255,255,255,.86); color: #123e72; font-size: 23rpx; font-weight: 700; box-shadow: 0 10rpx 24rpx rgba(34,67,108,.12); }
.reset-plus { font-size: 30rpx; vertical-align: -2rpx; }
.explore-card { position: relative; height: 300rpx; box-sizing: border-box; overflow: hidden; margin-bottom: 18rpx; padding: 40rpx 34rpx; border: 1rpx solid rgba(255,255,255,.55); border-radius: 42rpx; background: linear-gradient(135deg, #dce9f5 0%, #93b1cf 52%, #4e749f 100%); box-shadow: 0 22rpx 52rpx rgba(26,62,105,.2); }
.explore-copy { position: relative; z-index: 3; display: flex; flex-direction: column; }
.explore-kicker { color: #31577e; font-size: 18rpx; font-weight: 800; letter-spacing: 2rpx; }
.explore-title { margin-top: 15rpx; color: #fff; font-size: 48rpx; font-weight: 900; text-shadow: 0 4rpx 16rpx rgba(13,50,91,.22); }
.explore-subtitle { margin-top: 13rpx; color: rgba(255,255,255,.92); font-size: 23rpx; }
.compass { position: absolute; z-index: 4; right: 32rpx; top: 32rpx; display: flex; align-items: center; justify-content: center; width: 82rpx; height: 82rpx; border: 8rpx solid rgba(255,255,255,.65); border-radius: 50%; background: #0d3e7a; color: #fff; font-size: 38rpx; box-shadow: 0 12rpx 28rpx rgba(11,48,91,.28); }
.mountains { position: absolute; right: -50rpx; bottom: -140rpx; width: 530rpx; height: 330rpx; transform: rotate(18deg); border-radius: 80rpx; background: rgba(19,61,104,.42); }
.mountain-back { right: 180rpx; bottom: -230rpx; background: rgba(220,235,247,.55); transform: rotate(40deg); }
.status-row { display: flex; align-items: center; justify-content: space-between; padding: 4rpx 6rpx 18rpx; }
.status-chip { display: flex; align-items: center; padding: 9rpx 18rpx; border-radius: 999rpx; background: rgba(255,255,255,.68); color: #173f70; font-size: 22rpx; font-weight: 700; }
.status-dot { width: 12rpx; height: 12rpx; margin-right: 10rpx; border-radius: 50%; background: #36a46f; box-shadow: 0 0 0 6rpx rgba(54,164,111,.13); }
.status-hint, .working { color: #486581; font-size: 21rpx; }
.tabs { display: grid; grid-template-columns: repeat(3, 1fr); padding: 9rpx; margin-bottom: 22rpx; }
.tab { display: flex; align-items: center; justify-content: center; gap: 10rpx; padding: 17rpx 8rpx; border-radius: 25rpx; color: #6d7f98; text-align: center; font-size: 24rpx; font-weight: 700; }
.tab-icon { font-size: 28rpx; }
.tab.active { background: #0d3e7a; color: #fff; box-shadow: 0 10rpx 22rpx rgba(13,62,122,.24); }
.quick-strip { width: 100%; margin-bottom: 22rpx; white-space: nowrap; }
.quick-list { display: inline-flex; gap: 16rpx; padding: 4rpx 2rpx 16rpx; }
.quick-card { display: inline-flex; flex-direction: column; width: 210rpx; min-height: 190rpx; box-sizing: border-box; padding: 22rpx; white-space: normal; }
.quick-icon { display: flex; align-items: center; justify-content: center; width: 64rpx; height: 64rpx; border-radius: 21rpx; background: #e3edf8; color: #0d3e7a; font-size: 34rpx; }
.quick-title { margin-top: 17rpx; color: #142f55; font-size: 27rpx; font-weight: 800; }
.quick-action { margin-top: 9rpx; color: #66809d; font-size: 20rpx; }
.requirement { margin-bottom: 20rpx; padding: 24rpx; }
.section-title { margin-bottom: 18rpx; color: #153a68; font-size: 28rpx; font-weight: 800; }
.section-icon { color: #0d3e7a; }
.requirement-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 18rpx; }
.requirement-grid view { display: flex; flex-direction: column; gap: 5rpx; }
.requirement-grid text { color: #7a8ba1; font-size: 21rpx; }
.requirement-grid .value { color: #173d6b; font-size: 27rpx; font-weight: 700; }
.conversation-head { display: flex; align-items: center; justify-content: space-between; padding: 0 8rpx 12rpx; color: #17385f; font-size: 25rpx; font-weight: 800; }
.conversation-head text:last-child { padding: 4rpx 13rpx; border-radius: 999rpx; background: #0d3e7a; color: #fff; font-size: 17rpx; letter-spacing: 1rpx; }
.messages { height: 360rpx; box-sizing: border-box; padding: 24rpx; }
.message-row { display: flex; margin-bottom: 20rpx; }
.message-row.user { justify-content: flex-end; }
.bubble { max-width: 82%; padding: 20rpx 23rpx; border-radius: 26rpx 26rpx 26rpx 8rpx; background: #e8f0f8; color: #294662; line-height: 1.65; white-space: pre-wrap; }
.user .bubble { border-radius: 26rpx 26rpx 8rpx 26rpx; background: #0d3e7a; color: #fff; }
.typing { color: #75869b; }
.research { margin-top: 20rpx; padding: 24rpx; }
.research-line { display: flex; justify-content: space-between; padding: 10rpx 0; border-bottom: 1rpx solid #edf2f7; }
.status { color: #ae7015; }.status.done { color: #187052; }
.error { margin: 18rpx 0; padding: 18rpx 22rpx; border-radius: 16rpx; background: #fff0ed; color: #a54131; }
.composer { display: grid; grid-template-columns: 54rpx 1fr 78rpx; gap: 10rpx; align-items: center; margin-top: 20rpx; padding: 14rpx; }
.composer-pin { display: flex; align-items: center; justify-content: center; width: 54rpx; height: 54rpx; border-radius: 18rpx; background: #e4edf7; color: #174a82; font-size: 28rpx; }
.composer textarea { width: 100%; min-height: 74rpx; max-height: 210rpx; box-sizing: border-box; padding: 13rpx 8rpx; color: #173b68; }
.send { width: 72rpx; height: 72rpx; line-height: 72rpx; border-radius: 50%; background: #0d3e7a; color: #fff; font-size: 34rpx; font-weight: 800; box-shadow: 0 9rpx 20rpx rgba(13,62,122,.25); }
.send[disabled] { opacity: .48; }
.empty { padding: 80rpx 36rpx; color: #73849a; text-align: center; line-height: 1.8; }
.candidate-group { margin-bottom: 28rpx; }
.section-heading { display: flex; justify-content: space-between; margin: 24rpx 6rpx 14rpx; color: #153b69; font-weight: 800; }
.section-heading .count { color: #627b98; font-size: 22rpx; }
.candidate { margin-bottom: 16rpx; padding: 24rpx; }
.candidate-top { display: flex; justify-content: space-between; gap: 20rpx; color: #153c6b; }
.candidate-top .name { color: #153c6b; font-size: 31rpx; font-weight: 700; }.candidate-top text { color: #d09124; }
.description { margin-top: 15rpx; color: #526b86; line-height: 1.6; }
.meta { display: flex; gap: 14rpx; margin-top: 16rpx; color: #76879c; font-size: 22rpx; }
.day { margin-bottom: 20rpx; padding: 26rpx; }
.day-title { display: flex; justify-content: space-between; margin-bottom: 22rpx; color: #153d6e; font-size: 31rpx; font-weight: 800; }
.timeline-item { display: grid; grid-template-columns: 90rpx 24rpx 1fr; gap: 12rpx; min-height: 118rpx; }
.time { color: #1a5795; font-weight: 700; }
.timeline-dot { width: 16rpx; height: 16rpx; margin-top: 10rpx; border-radius: 50%; background: #0d3e7a; box-shadow: 0 0 0 7rpx #dce8f5; }
.activity { display: flex; flex-direction: column; gap: 7rpx; padding-bottom: 22rpx; border-bottom: 1rpx solid #e6edf4; }
.activity .name { color: #153d6c; font-size: 28rpx; font-weight: 700; }.activity text { color: #586f88; font-size: 23rpx; }
.activity .activity-kind { color: #8190a3; font-size: 20rpx; text-transform: uppercase; letter-spacing: 1rpx; }
.warning { margin-top: 22rpx; padding: 24rpx; color: #75571e; line-height: 1.75; background: #fffaf0; }
