<view class="insight-page" style="padding-top:{{navH}}px"><xj-nav-bar title="Agent 透视" subtitle="本次运行记录" left-text="返回" bind:left="goBack" bind:ready="onNavReady"></xj-nav-bar>
  <scroll-view scroll-x class="tabs"><view wx:for="{{tabs}}" wx:key="key" class="tab {{active===item.key?'is-active':''}}" data-key="{{item.key}}" bindtap="chooseTab">{{item.label}}</view></scroll-view>
  <view wx:if="{{loading}}" class="panel"><xj-skeleton type="card" rows="{{4}}"></xj-skeleton></view>
  <view wx:elif="{{active==='intent'}}" class="panel"><view class="source">{{insight.intent.source}}</view><view class="card"><view class="card__title">意图路径</view><view class="metric">{{insight.intent.path || '尚无意图记录'}}</view><view>置信度：{{insight.intent.confidence == null ? '未记录' : insight.intent.confidence}}</view></view></view>
  <view wx:elif="{{active==='memory'}}" class="panel"><view class="source">{{insight.memory.source}}</view><view class="card"><view class="card__title">L0–L3 记忆</view><view>L0 本轮需求：{{insight.memory.l0?'已读取':'未读取'}}</view><view>L1 本行程消息：{{insight.memory.l1}} 条</view><view>L2 相似旅行：{{insight.memory.l2}} 条</view><view>L3 长期偏好：{{insight.memory.l3.length}} 条</view><view wx:for="{{insight.memory.l3}}" wx:key="*this" class="detail">{{item}}</view></view></view>
  <view wx:elif="{{active==='tools'}}" class="panel"><view class="source">{{insight.tools.source}}</view><view class="card"><view class="card__title">工具调用结果</view><view>高德真实路线：{{insight.tools.real_routes}} 段</view><view>进入规划的候选：{{insight.tools.candidate_count}} 个</view><view class="detail">这里只展示本次被持久化的事实；没有记录的耗时或缓存命中不会伪造。</view></view></view>
  <view wx:elif="{{active==='quality'}}" class="panel"><view class="source">{{insight.quality.source}}</view><view class="card"><view class="card__title">质量评审</view><view class="metric">Reviewer {{insight.quality.reviewer == null ? '未记录' : insight.quality.reviewer + '/100'}}</view><view>Strict：{{insight.quality.strict == null ? '未记录' : insight.quality.strict + '/100'}}</view><view wx:for="{{insight.quality.issues}}" wx:key="*this" class="issue">{{index+1}}. {{item}}</view></view></view>
  <view wx:elif="{{active==='changes'}}" class="panel"><view wx:if="{{!insight.changes.length}}" class="card">本行程还没有手动变更</view><view wx:for="{{insight.changes}}" wx:key="version" class="card"><view class="card__title">版本 {{item.version}} · {{item.summary}}</view><view wx:for="{{item.items}}" wx:key="item_id" class="diff">{{item.action}} · {{item.name || item.item_id}}</view></view></view>
  <view wx:else class="panel"><view class="source">{{insight.developer.source}}</view><view class="card"><view class="card__title">开发者信息</view><view>plan_version：{{insight.developer.plan_version}}</view><view>stage：{{insight.developer.stage || '未记录'}}</view><view>node：{{insight.developer.node || '未记录'}}</view></view></view>
</view>
