@import "../../styles/tokens.wxss";.insight-page{min-height:100vh;box-sizing:border-box;background:var(--xj-bg)}.tabs{white-space:nowrap;background:var(--xj-card);border-bottom:2rpx solid var(--xj-line)}.tab{display:inline-block;padding:var(--xj-space-2) var(--xj-space-3);border-radius:var(--xj-radius-pill);color:var(--xj-text2);font-size:var(--xj-font-sm)}.tab.is-active{background:var(--xj-primary-light);color:var(--xj-primary);font-weight:var(--xj-weight-bold)}.panel{display:flex;flex-direction:column;gap:var(--xj-space-3);padding:var(--xj-space-4)}.source{align-self:flex-start;padding:var(--xj-space-1) var(--xj-space-2);border-radius:var(--xj-radius-pill);background:var(--xj-success-light);color:var(--xj-success);font-size:var(--xj-font-mini)}.card{display:flex;flex-direction:column;gap:var(--xj-space-2);padding:var(--xj-space-3);border:2rpx solid var(--xj-line);border-radius:var(--xj-radius-md);background:var(--xj-card);font-size:var(--xj-font-sm)}.card__title{font-size:var(--xj-font-h3);font-weight:var(--xj-weight-bold)}.metric{color:var(--xj-primary);font-size:var(--xj-font-h2);font-weight:var(--xj-weight-bold)}.detail{padding:var(--xj-space-2);border-radius:var(--xj-radius-sm);background:var(--xj-primary-light);color:var(--xj-text2)}.issue{color:var(--xj-error)}.diff{padding:var(--xj-space-2);border-left:6rpx solid var(--xj-success);background:var(--xj-success-light)}
