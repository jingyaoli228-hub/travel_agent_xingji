<view class="import-page" style="padding-top:{{navH}}px"><xj-nav-bar title="导入小红书笔记" left-text="返回" bind:left="goBack" bind:ready="onNavReady"></xj-nav-bar>
  <view wx:if="{{phase==='input'}}" class="content"><view class="notice">只支持粘贴链接和正文，不登录小红书、不做在线搜索。</view><textarea value="{{content}}" maxlength="5000" placeholder="粘贴 xhslink 链接和笔记正文；只有链接打不开时，请把正文也粘贴进来" bindinput="onInput"></textarea><view class="count">{{content.length}} / 5000</view><view class="dual"><xj-button type="secondary" bind:tap="paste">从剪贴板粘贴</xj-button><xj-button type="primary" disabled="{{!content}}" bind:tap="parse">开始解析</xj-button></view></view>
  <view wx:elif="{{phase==='parsing'}}" class="content"><view class="parse-title">正在解析…</view><view class="parse-step">读取链接与正文 ✓</view><view class="parse-step">抽取地点 ●</view><view class="parse-step is-muted">匹配高德地点 ○</view><xj-skeleton type="list" rows="{{3}}"></xj-skeleton></view>
  <view wx:elif="{{phase==='result'}}" class="content"><xj-import-result source="小红书 · 用户粘贴" title="{{parsed.title}}" places="{{parsed.places}}" confirm-text="加到当前行程" bind:change="onPlaceChange" bind:fix="fixPlace" bind:origin="copyOrigin" bind:confirm="addToTrip"></xj-import-result><xj-button type="secondary" block loading="{{busy}}" bind:tap="storeOnly">只存进知识库</xj-button></view>
  <view wx:else class="content error"><view class="error__icon">!</view><view class="parse-title">解析失败</view><view class="notice is-error">{{error}}</view><view class="help">链接打不开时：在小红书打开笔记 → 长按正文 → 全选 → 复制，再回到这里粘贴。</view><view class="dual"><xj-button type="secondary" bind:tap="paste">从剪贴板粘贴</xj-button><xj-button type="primary" bind:tap="retry">重新解析</xj-button></view></view>
</view>
