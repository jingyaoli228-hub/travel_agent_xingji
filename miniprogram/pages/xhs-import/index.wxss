@import "../../styles/tokens.wxss";@import "../../styles/icons.wxss";.import-page{min-height:100vh;box-sizing:border-box;background:var(--xj-bg)}.content{padding:var(--xj-space-4)}.notice,.help,.parse-step{padding:var(--xj-space-3);border-radius:var(--xj-radius-md);background:var(--xj-warn-light);color:var(--xj-warn-text);font-size:var(--xj-font-sm);line-height:1.6}.content textarea{box-sizing:border-box;width:100%;min-height:360rpx;margin-top:var(--xj-space-3);padding:var(--xj-space-3);border:2rpx solid var(--xj-primary);border-radius:var(--xj-radius-md);background:var(--xj-card);font-size:var(--xj-font-body)}.count{text-align:right;color:var(--xj-text3);font-size:var(--xj-font-mini)}.dual{display:flex;gap:var(--xj-space-2);margin-top:var(--xj-space-4)}.dual xj-button{flex:1}.parse-title{margin:var(--xj-space-4) 0;font-size:var(--xj-font-h2);font-weight:var(--xj-weight-bold)}.parse-step{margin-bottom:var(--xj-space-2);background:var(--xj-primary-light);color:var(--xj-primary)}.parse-step.is-muted{background:var(--xj-card);color:var(--xj-text3)}.error{text-align:center}.error__icon{display:flex;width:96rpx;height:96rpx;align-items:center;justify-content:center;margin:var(--xj-space-6) auto 0;border-radius:var(--xj-radius-pill);background:var(--xj-error-light);color:var(--xj-error);font-size:var(--xj-font-h1);font-weight:var(--xj-weight-bold)}.notice.is-error{background:var(--xj-error-light);color:var(--xj-error)}.help{margin-top:var(--xj-space-3);background:var(--xj-card);color:var(--xj-text2);text-align:left}
