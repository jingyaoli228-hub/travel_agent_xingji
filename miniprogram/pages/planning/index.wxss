@import "../../styles/tokens.wxss";
@import "../../styles/icons.wxss";

.candidate__body{flex:1;min-width:0;padding-right:var(--xj-space-2)}
.candidate__desc{display:block;margin-top:var(--xj-space-2);color:var(--xj-text2);font-size:var(--xj-font-sm);line-height:1.55}

.clarification-card{padding:var(--xj-space-4);margin-bottom:var(--xj-space-3);border:2rpx solid var(--xj-line);border-radius:var(--xj-radius-md);background:var(--xj-card)}
.clarification-card .section-title{margin-top:0}
.clarification-card__question{color:var(--xj-text2);font-size:var(--xj-font-sm);line-height:1.7;white-space:pre-wrap}

.planning-page{min-height:100vh;background:var(--xj-bg);box-sizing:border-box}.flow{padding:var(--xj-space-5) var(--xj-space-4) var(--xj-space-6)}.flow__title{font-size:var(--xj-font-h2);font-weight:var(--xj-weight-bold);text-align:center;margin:var(--xj-space-3) 0 var(--xj-space-1)}.flow__sub{font-size:var(--xj-font-sm);color:var(--xj-text2);text-align:center;margin-bottom:var(--xj-space-4)}.hero-art{height:220rpx;position:relative;overflow:hidden;border-radius:var(--xj-radius-lg);background:var(--xj-primary-light)}.hero-art__sun{position:absolute;width:88rpx;height:88rpx;border-radius:var(--xj-radius-pill);background:var(--xj-accent);right:88rpx;top:38rpx}.hero-art__mountain{position:absolute;left:60rpx;right:60rpx;bottom:-80rpx;height:220rpx;background:var(--xj-primary);border-radius:50% 50% 0 0}.prompt-box,.line-input{box-sizing:border-box;width:100%;background:var(--xj-card);border:2rpx solid var(--xj-line);border-radius:var(--xj-radius-md);font-size:var(--xj-font-body);padding:var(--xj-space-3);margin-bottom:var(--xj-space-3)}.prompt-box{min-height:180rpx}.quick-title,.section-title{font-size:var(--xj-font-body);font-weight:var(--xj-weight-bold);margin:var(--xj-space-4) 0 var(--xj-space-2)}.section-title text{font-size:var(--xj-font-mini);font-weight:var(--xj-weight-regular);color:var(--xj-text3)}.quick-list,.option-row{display:flex;gap:var(--xj-space-2);flex-wrap:wrap;margin-bottom:var(--xj-space-4)}.quick{padding:var(--xj-space-2) var(--xj-space-3);border:2rpx solid var(--xj-line);border-radius:var(--xj-radius-pill);font-size:var(--xj-font-sm);background:var(--xj-card)}.requirement-card,.profile-hint,.prepare-row,.background-tip{padding:var(--xj-space-3);border-radius:var(--xj-radius-md);font-size:var(--xj-font-sm)}.requirement-card{background:var(--xj-card);border:2rpx solid var(--xj-line)}.profile-hint{margin-top:var(--xj-space-2);background:var(--xj-info-light);color:var(--xj-info)}.prepare-row{display:flex;justify-content:space-between;background:var(--xj-card);color:var(--xj-text2);margin:var(--xj-space-4) 0}.prepare-row text:last-child{font-size:var(--xj-font-mini)}.progress-pill,.draft-score{display:table;margin:0 auto;padding:var(--xj-space-1) var(--xj-space-3);border-radius:var(--xj-radius-pill);background:var(--xj-primary-light);color:var(--xj-primary);font-size:var(--xj-font-sm)}.progress-track{height:12rpx;background:var(--xj-line);border-radius:var(--xj-radius-pill);overflow:hidden;margin-bottom:var(--xj-space-4)}.progress-track__fill{height:100%;background:var(--xj-primary);transition:width .3s}.day-skeleton,.draft-day,.candidate,.quality-card,.partial{background:var(--xj-card);border:2rpx solid var(--xj-line);border-radius:var(--xj-radius-md);padding:var(--xj-space-3);margin-bottom:var(--xj-space-3)}.day-skeleton__head,.draft-day__head{font-weight:var(--xj-weight-bold);font-size:var(--xj-font-body);margin-bottom:var(--xj-space-2)}.day-skeleton__head text{float:right;color:var(--xj-text3);font-size:var(--xj-font-mini);font-weight:var(--xj-weight-regular)}.day-skeleton.is-ready{border-color:var(--xj-success);background:var(--xj-success-light)}.ready-line,.background-tip{color:var(--xj-text2);font-size:var(--xj-font-sm)}.background-tip{text-align:center}.capacity{font-size:var(--xj-font-h3);font-weight:var(--xj-weight-bold);margin-bottom:var(--xj-space-2)}.overflow{padding:var(--xj-space-3);background:var(--xj-error-light);color:var(--xj-error);border-radius:var(--xj-radius-md)}.candidate{display:flex;justify-content:space-between;align-items:center}.candidate__name,.candidate__meta{display:block}.candidate__name{font-weight:var(--xj-weight-bold)}.candidate__meta{font-size:var(--xj-font-mini);color:var(--xj-text3);margin-top:var(--xj-space-1)}.choice{padding:var(--xj-space-1) var(--xj-space-2);border-radius:var(--xj-radius-xs);font-size:var(--xj-font-mini);background:var(--xj-exclude)}.choice--must{background:var(--xj-success-light);color:var(--xj-success)}.choice--want{background:var(--xj-primary);color:var(--xj-card)}.choice--optional{background:var(--xj-primary-light);color:var(--xj-primary)}.choice--exclude{color:var(--xj-text3)}.dual-actions{display:flex;gap:var(--xj-space-2);margin-top:var(--xj-space-4)}.dual-actions xj-button{flex:1}.draft-score.is-draft{background:var(--xj-warn-light);color:var(--xj-warn-text)}.draft-score.is-pass{background:var(--xj-success-light);color:var(--xj-success)}.quality-card{background:var(--xj-warn-light);border-color:var(--xj-warn)}.quality-card__title{font-weight:var(--xj-weight-bold);margin-bottom:var(--xj-space-2)}.quality-card__issue{font-size:var(--xj-font-sm);margin:var(--xj-space-1) 0}.draft-item{display:flex;gap:var(--xj-space-3);padding:var(--xj-space-2) 0;border-top:2rpx solid var(--xj-line);font-size:var(--xj-font-sm)}.draft-item text:first-child{color:var(--xj-text3);min-width:96rpx}.error-state{text-align:center}.error-icon{width:96rpx;height:96rpx;line-height:96rpx;margin:var(--xj-space-6) auto var(--xj-space-3);border-radius:var(--xj-radius-pill);background:var(--xj-error-light);color:var(--xj-error);font-size:var(--xj-font-h1);font-weight:var(--xj-weight-bold)}.partial{text-align:left}
