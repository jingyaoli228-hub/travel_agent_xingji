@import "../../styles/tokens.wxss";@import "../../styles/icons.wxss";.add-page{min-height:100vh;box-sizing:border-box;background:var(--xj-bg);padding-bottom:var(--xj-space-6)}.search{display:flex;gap:var(--xj-space-2);padding:var(--xj-space-3);background:var(--xj-card);border-bottom:2rpx solid var(--xj-line)}.search input{flex:1;padding:var(--xj-space-2) var(--xj-space-3);border:2rpx solid var(--xj-primary);border-radius:var(--xj-radius-pill);font-size:var(--xj-font-body)}.results,.preview-flow{padding:var(--xj-space-3)}.result{display:flex;justify-content:space-between;padding:var(--xj-space-3);border-bottom:2rpx solid var(--xj-line);background:var(--xj-card)}.result text{display:block;font-size:var(--xj-font-sm)}.result view text:first-child{font-size:var(--xj-font-body);font-weight:var(--xj-weight-bold)}.result view text:last-child{margin-top:var(--xj-space-1);color:var(--xj-text3)}.place-title,.preview-title{font-size:var(--xj-font-h3);font-weight:var(--xj-weight-bold);margin:var(--xj-space-3) 0}.place-card,.day-preview{display:flex;flex-direction:column;gap:var(--xj-space-3);padding:var(--xj-space-3);margin-top:var(--xj-space-3);border:2rpx solid var(--xj-line);border-radius:var(--xj-radius-md);background:var(--xj-card)}.place-card text:first-child{font-size:var(--xj-font-h3);font-weight:var(--xj-weight-bold)}.place-card text:nth-child(2){color:var(--xj-text3)}.preview-item{display:grid;grid-template-columns:100rpx 1fr auto;gap:var(--xj-space-2);padding:var(--xj-space-3);border:2rpx solid var(--xj-line);border-radius:var(--xj-radius-md);font-size:var(--xj-font-sm)}.preview-item.is-new{border-color:var(--xj-primary);background:var(--xj-primary-light);color:var(--xj-primary)}.impact{padding:var(--xj-space-3);border-radius:var(--xj-radius-md);background:var(--xj-warn-light);color:var(--xj-warn-text);font-size:var(--xj-font-sm)}
