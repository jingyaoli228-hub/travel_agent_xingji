@import "../../styles/tokens.wxss";@import "../../styles/icons.wxss";.trips-page{min-height:100vh;box-sizing:border-box;background:var(--xj-bg);padding-bottom:var(--xj-space-6)}.top-actions{display:flex;gap:var(--xj-space-2);padding:var(--xj-space-3);background:var(--xj-card)}.top-actions xj-button{flex:1}.sort-hint,.delete-hint{padding:var(--xj-space-3);color:var(--xj-text3);font-size:var(--xj-font-mini)}.trip-list{display:flex;flex-direction:column;gap:var(--xj-space-2);padding:0 var(--xj-space-3)}.empty-list{padding:var(--xj-space-6);color:var(--xj-text3);text-align:center}
