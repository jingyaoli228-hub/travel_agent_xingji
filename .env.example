# Copy to .env on the server and replace every change_me value.
ENVIRONMENT=production
DEBUG=false
REQUIRE_PERSISTENT_SERVICES=true
DOMAIN=:80
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Internal services (not published to the Internet)
POSTGRES_PASSWORD=change_me_long_random_password
DATABASE_URL=postgresql://travel_agent:change_me_long_random_password@postgres:5432/travel_agent
REDIS_URL=redis://redis:6379/0
REDIS_KEY_PREFIX=travel_agent:session:
REDIS_TTL_SECONDS=604800
CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_SSL=false
RESEARCH_QUEUE_NAME=research
RESEARCH_JOB_TIMEOUT_SECONDS=900
RESEARCH_JOB_MAX_RETRIES=2
RESEARCH_STALE_AFTER_SECONDS=1200

# Primary LLM (leave unused providers blank)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_FAST_MODEL=deepseek-chat
DEEPSEEK_DEEP_MODEL=deepseek-reasoner
KIMI_API=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k2.6
KIMI_REQUIREMENT_API=
KIMI_PLANNER_API=
KIMI_REVIEWER_API=
KIMI_RESEARCH_API=
KIMI_INTENT_API=
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.3

# AMap: server-side Web Service key and separate browser JS API credentials
AMAP_WEB_SERVICE_KEY=
VITE_AMAP_JS_API_KEY=
VITE_AMAP_JS_SECURITY_CODE=

# Computer/browser-bound tools. These commands will fail in the base cloud
# image unless you deliberately install and authenticate their runtimes.
AGENT_REACH_SEARCH_CMD=xhs search "{query}"
XHS_SEARCH_CMD=opencli xiaohongshu search "{query}" --limit {limit} -f json

EPISODIC_MEMORY_PATH=/legacy-data/episodic_memory.jsonl
USER_PROFILE_STORE_PATH=/legacy-data/user_profiles.json
MAX_REVIEW_LOOPS=3
REVIEW_PASS_SCORE=85
MAX_RESEARCH_EXPANSION_LOOPS=2
API_HOST=0.0.0.0
API_PORT=8000
